# Local development defaults. Every secret below is a PUBLIC dev placeholder.
# Copy to .env for local use. For any real deployment set ENVIRONMENT=production and replace every
# secret; the services refuse to start in production while dev placeholders are still set.
ENVIRONMENT=dev

POSTGRES_USER=rideassist
POSTGRES_PASSWORD=rideassist
POSTGRES_DB=rideassist
DATABASE_URL=postgresql+asyncpg://rideassist:rideassist@db:5432/rideassist
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
INTERNAL_API_KEY=dev-only-internal-key

# Verification
OTP_SECRET=dev-only-otp-pepper-change-me
# Fernet key (32 url-safe base64 bytes). Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# DEV ONLY: this key is public. Losing the real key makes uploaded documents unreadable.
DOCUMENT_ENCRYPTION_KEY=nowhJxoHbQ0yFohEPvYRFPMTrQBYzud50qKjhYH5Ohg=

# Document storage: "local" (encrypted files on a volume) or "s3" (AWS S3 / MinIO)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/documents
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=rideassist
S3_SECRET_KEY=rideassist-secret
S3_BUCKET=rideassist-documents

# Notifications
NOTIFICATION_SERVICE_URL=http://notification:8000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=RideAssist <no-reply@rideassist.dev>

# Routing / ETA. Leave OSRM_URL empty to use straight-line ETA.
OSRM_URL=
# Local dev / E2E: every request comes from one IP, so loosen per-IP limits. Use 1 in production.
RATE_LIMIT_MULTIPLIER=10
CORS_ORIGINS=["http://localhost:4200","http://localhost:8100"]
